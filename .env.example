# ─────────────────────────────────────────────────────────────────────────────
# DevMind Multi-Agent MCP — Environment Variables
# Copy this to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── CockroachDB Serverless ────────────────────────────────────────────────────
# Found in: CockroachDB Cloud Console → Cluster → Connect → Connection String
# Free tier: cockroachlabs.com → create account → Create Cluster (Serverless, free)
COCKROACH_DB_URI=postgresql://your_user:your_password@your-cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# ── Groq API (LLM — Llama 3.1 70B — completely FREE) ───────────────────────────
# Get your FREE key at: console.groq.com → API Keys
# No credit card needed. Uses Llama 3.1 70B model.
GROQ_API_KEY=gsk_your-groq-key-here

# ── GitHub ────────────────────────────────────────────────────────────────────
# Generate at: github.com → Settings → Developer Settings → Personal Access Tokens
# Scopes needed: repo (read-only is enough for public repos)
GITHUB_TOKEN=github_pat_your_new_token_here

# The default repo to index when running: python mcp_server.py --ingest
# Format: owner/repo-name  (e.g. "octocat/Hello-World")
GITHUB_REPO=owner/repo-name

# ── Local Embeddings (no config needed) ──────────────────────────────────────
# DevMind uses sentence-transformers/all-MiniLM-L6-v2 for embeddings.
# It downloads ~90 MB automatically on first run and caches locally.
# No API key, no cost, runs on CPU. Nothing to configure here.
